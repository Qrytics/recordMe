// Copy to secrets.h and fill in. secrets.h is gitignored.
#pragma once

// Home Wi-Fi. Hardcoded deliberately: the device has no UI to configure it with.
#define WIFI_SSID     "your-ssid"
#define WIFI_PASSWORD "your-password"

// The Pi's upload receiver. LAN address, plain HTTP — the device never leaves the
// LAN, so TLS on the ESP32 would cost RAM, CPU, and battery for nothing.
// Use a static lease or reserved IP for the Pi so this doesn't drift.
#define PI_UPLOAD_URL "http://192.168.1.50:8000/upload"

// Shared secret, sent as `Authorization: Bearer <token>`. Must match
// RECORDME_UPLOAD_TOKEN in pi/.env. Generate with: openssl rand -hex 32
#define UPLOAD_TOKEN  "replace-me"
