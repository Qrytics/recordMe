# Copy to .env and fill in. .env is gitignored.

# Shared secret for uploads. Must match UPLOAD_TOKEN in firmware/recordme/secrets.h.
# Generate with: openssl rand -hex 32
RECORDME_UPLOAD_TOKEN=replace-me

# Paths. The DB goes on the SD card (small, needs low latency); audio goes on the
# 2 TB HDD (bulky, sequential writes).
RECORDME_DB_PATH=/home/pi/recordme/recordme.db
RECORDME_AUDIO_DIR=/mnt/hdd/recordme/audio

# Bind addresses. These are deliberately different: the receiver is LAN-only and
# the device never uses the tunnel, while search is reachable over Tailscale.
# See docs/PLAN_REVIEW.md section 9.1. Never port-forward either to the internet.
RECORDME_RECEIVER_HOST=0.0.0.0
RECORDME_RECEIVER_PORT=8000
RECORDME_SEARCH_HOST=127.0.0.1
RECORDME_SEARCH_PORT=8001

# Password for the search UI — defence in depth behind the tunnel.
RECORDME_SEARCH_PASSWORD=replace-me

# Transcription
RECORDME_WHISPER_MODEL=small.en
RECORDME_WHISPER_COMPUTE=int8
RECORDME_WHISPER_THREADS=4
RECORDME_VAD_ENABLED=1

# Local LLM
RECORDME_OLLAMA_URL=http://127.0.0.1:11434
RECORDME_OLLAMA_MODEL=llama3.1:8b
